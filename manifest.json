{
  "manifest_version": 3,
  "name": "Color Collapse for Fabletics",
  "version": "0.4.0",
  "description": "See each Fabletics product once instead of once per color. Same grid, same filters, a fraction of the scrolling.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.fabletics.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Color Collapse for Fabletics",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon128.png"
      ],
      "matches": [
        "https://*.fabletics.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.fabletics.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.fabletics.com/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
